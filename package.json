{
  "name": "simply-logs",
  "productName": "Simply Logs",
  "version": "1.0.0",
  "description": "A calm desktop home for deployment logs and health checks, with a cat companion.",
  "homepage": "https://github.com/schorts99/simply-logs",
  "repository": {
    "type": "git",
    "url": "https://github.com/schorts99/simply-logs.git"
  },
  "desktopName": "app.simplylogs.desktop",
  "author": "Simply Logs contributors",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "engines": {
    "node": "^26.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "build": "npm run icons && vite build && node scripts/build-desktop.mjs",
    "icons": "node scripts/icons.mjs",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:desktop": "playwright test",
    "check": "npm run lint && npm test && npm run build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "build": {
    "appId": "app.simplylogs.desktop",
    "productName": "Simply Logs",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "artifactName": "Simply-Logs-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": "-",
      "target": ["dmg", "zip"]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "syncDesktopName": true,
      "icon": "build/icon.png",
      "category": "Development",
      "target": ["AppImage", "deb"],
      "maintainer": "Simply Logs contributors"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2 | libasound2t64",
        "libgbm1"
      ]
    }
  }
}
